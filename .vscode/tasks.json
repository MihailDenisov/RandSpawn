{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "gradle: build",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew",
      "args": ["build"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$javac"]
    },
    {
      "label": "gradle: test",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew",
      "args": ["test"],
      "group": "test",
      "problemMatcher": ["$javac"]
    },
    {
      "label": "gradle: runServer",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew",
      "args": ["runServer"],
      "problemMatcher": []
    },
    {
      "label": "gradle: runClient",
      "type": "shell",
      "command": "${workspaceFolder}/gradlew",
      "args": ["runClient"],
      "problemMatcher": []
    }
  ]
}
